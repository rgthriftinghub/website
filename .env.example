# Copy this file to `.env` and replace every placeholder before running the stack.
# `.env` is ignored by Git. Never commit real secrets.

# Application
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (defaults match the Docker Compose db service)
POSTGRES_DB=rg_thrifting_hub
POSTGRES_USER=rgthrifting
POSTGRES_PASSWORD=replace-with-a-local-password
# Host is the `db` service name inside Docker. Use `localhost` when you run the
# backend directly on your machine. Keep the credentials in sync with POSTGRES_* above.
DATABASE_URL=postgresql+psycopg://rgthrifting:replace-with-a-local-password@db:5432/rg_thrifting_hub

# API — comma-separated list of allowed browser origins. Must not be "*" in production.
CORS_ORIGINS=http://localhost:3000

# Frontend — baked into the browser bundle at build time, so it must be the
# host-visible backend URL (not a Docker service name). No secrets belong here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Used only by Next.js server-side rendering, which runs inside the frontend
# container where "localhost" is not the API. Leave unset outside Docker.
API_INTERNAL_BASE_URL=http://backend:8000/api/v1

# Public storefront URL. Used to build links and the logo URL inside notification
# emails, and to build gateway return/cancel URLs.
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------- commerce
CURRENCY_CODE=PKR
BUSINESS_TIMEZONE=Asia/Karachi
# Fallback delivery pricing. Once a ShippingMethod row exists in the database it
# takes precedence, so staff can change the charge without a redeploy.
STANDARD_DELIVERY_CHARGE=250.00
FREE_DELIVERY_THRESHOLD=10000.00
MAX_QUANTITY_PER_ITEM=10

# ---------------------------------------------------------------- payments
# Cash on Delivery and Bank Transfer need no configuration. JazzCash/Easypaisa are
# manual wallet transfers; set the receiving numbers and WhatsApp destination below.
#
# The gateway variables below are read but currently UNUSED: no gateway integration
# is implemented, because that requires each provider's official API documentation.
# Setting these does NOT enable a gateway. See docs/payments.md.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_API_URL=

SAFEPAY_API_KEY=
SAFEPAY_API_URL=

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=

# Manual mobile-wallet transfers (no gateway/API integration). Wallet options
# appear at checkout when their number and the WhatsApp number are configured.
JAZZCASH_NUMBER=
EASYPAISA_NUMBER=
PAYMENT_WHATSAPP_NUMBER=

# ------------------------------------------------------------ notifications
# "log" renders the branded template and writes it to the application log without
# sending. Set to "smtp" to deliver for real — SMTP_HOST is then required and the
# app refuses to start without it.
EMAIL_PROVIDER=log
EMAIL_FROM_NAME=RG Thrifting Hub
EMAIL_FROM_ADDRESS=no-reply@rgthriftinghub.pk
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Only "log" is implemented. Integrating a real provider requires an approved
# WhatsApp Business account and Meta-approved message templates.
WHATSAPP_PROVIDER=log
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_SENDER=

# ---------------------------------------------------------------- shipping
# Only "manual" is implemented: staff book with the courier and enter the tracking
# number. No courier API integration exists. See docs/shipping.md.
COURIER_PROVIDER=manual
COURIER_API_KEY=
COURIER_API_URL=

# ------------------------------------------------------------ seed (dev only)
# Development seed passwords. Never used in production.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
